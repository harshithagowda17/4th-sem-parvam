# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/hotel_booking
# Alternative for MySQL: mysql://username:password@localhost:3306/hotel_booking

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Environment
NODE_ENV=development

# Optional: Authentication (for future implementation)
JWT_SECRET=your_jwt_secret_key_here
NEXT_PUBLIC_AUTH_ENABLED=false

# Optional: Email Service (for booking confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@hotelbooking.com

# Optional: Payment Gateway (for future implementation)
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key

# Logging
LOG_LEVEL=info
